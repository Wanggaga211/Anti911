@echo off
rem Build ShareRpcLab.exe with VS2019 x64 toolchain.
rem Keep this file pure ASCII: cmd.exe parses .bat in the OEM code page,
rem so any non-ASCII byte here gets chopped into garbage commands.
setlocal
call "D:\Program Files (x86)\Microsoft Visual Studio\2019\Enterprise\VC\Auxiliary\Build\vcvars64.bat" >nul
if errorlevel 1 (
    echo [build] vcvars64.bat not found - edit the call line of build.bat
    exit /b 1
)

cd /d "%~dp0"

rem /wd4819: MSVC2019 reports a spurious C4819 for fullwidth punctuation
rem (U+FF0C and friends) even with a UTF-8 BOM and /utf-8. Isolation test:
rem   printf("exec")  -> no warning   printf("fullwidth comma") -> C4819
rem The generated bytes are correct, so the warning is muted on purpose.
echo [build] cl ...
cl /nologo /c /utf-8 /wd4819 /O2 /W3 /D_CRT_SECURE_NO_WARNINGS ShareRpcLab.c Layer1_SharedMem.c Layer2_DirectSyscall.c Layer3_ChainHijack.c
if errorlevel 1 exit /b 1

echo [build] ml64 ...
ml64 /nologo /c /FoNtStub.obj NtStub.asm
if errorlevel 1 exit /b 1

echo [build] link ...
link /nologo /SUBSYSTEM:CONSOLE /MACHINE:X64 /MAP /OUT:ShareRpcLab.exe ShareRpcLab.obj Layer1_SharedMem.obj Layer2_DirectSyscall.obj Layer3_ChainHijack.obj NtStub.obj kernel32.lib
if errorlevel 1 exit /b 1

echo [build] OK - ShareRpcLab.exe
endlocal
